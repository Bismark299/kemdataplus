// Prisma Schema for KemDataplus
// PostgreSQL database - Multi-Tenant Reseller Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

// Role hierarchy (highest to lowest): ADMIN > PARTNER > SUPER_DEALER > DEALER > SUPER_AGENT > AGENT
enum Role {
  ADMIN
  PARTNER
  SUPER_DEALER
  DEALER
  SUPER_AGENT
  AGENT
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  DUPLICATE_HOLD
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PURCHASE
  REFUND
  TRANSFER_IN
  TRANSFER_OUT
  PROFIT_CREDIT
  COMMISSION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum PayoutStatus {
  PENDING
  RESERVED      // Balance reserved, awaiting processing
  PROCESSING    // Sent to Paystack, awaiting webhook confirmation
  COMPLETED
  FAILED
  REJECTED
}

enum PendingProfitStatus {
  PENDING
  PAID
  CANCELLED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DISABLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PRICE_CHANGE
  WALLET_CREDIT
  WALLET_DEBIT
  PROFIT_ALLOCATION
  ORDER_CREATE
  ORDER_COMPLETE
  ORDER_CANCEL
  ADMIN_OVERRIDE
  TENANT_CREATE
  TENANT_SUSPEND
  ROLE_CHANGE
  // Payout audit actions
  PAYOUT_REQUEST
  PAYOUT_ACCUMULATE
  PAYOUT_APPROVE
  PAYOUT_REJECT
  PAYOUT_PROCESS
  PAYOUT_COMPLETE
  PAYOUT_FAIL
  PAYOUT_FORCE_COMPLETE
  PAYOUT_FORCE_CANCEL
  PAYOUT_CANCEL
}

// ============================================
// TENANT & HIERARCHY MODELS
// ============================================

model Tenant {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique // subdomain or identifier
  domain          String?      @unique // custom domain mapping
  
  // Hierarchy
  parentId        String?      
  hierarchyLevel  Int          @default(0) // depth in tree (root = 0)
  hierarchyPath   String       @default("/") // materialized path for quick queries
  
  // Settings & Branding
  brandName       String?
  logoUrl         String?
  primaryColor    String?      @default("#024959")
  secondaryColor  String?      @default("#F2C12E")
  
  // Capabilities
  canCreateSubTenant  Boolean  @default(false)
  maxSubTenants       Int      @default(0)
  maxUsers            Int      @default(100)
  
  // Financial Controls
  dailyTransactionCap Float?
  monthlyTransactionCap Float?
  minProfitMargin     Float    @default(0)
  
  // Status
  status          TenantStatus @default(ACTIVE)
  isRoot          Boolean      @default(false)
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdById     String?

  // Relations
  parent          Tenant?      @relation("TenantHierarchy", fields: [parentId], references: [id])
  children        Tenant[]     @relation("TenantHierarchy")
  users           User[]
  tenantPrices    TenantBundlePrice[]
  profitRecords   ProfitRecord[]
  auditLogs       AuditLog[]
  storefronts     Storefront[]
  
  @@index([parentId])
  @@index([slug])
  @@index([domain])
  @@index([hierarchyPath])
  @@map("tenants")
}

// ============================================
// USER MODEL (Extended)
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role     @default(AGENT)
  isActive  Boolean  @default(true)
  agentCode String?  @unique           // Unique agent identifier (KDP-XXXX)
  
  // Tenant & Hierarchy
  tenantId         String?
  parentUserId     String?
  hierarchyLevel   Int           @default(0)
  canCreateUsers   Boolean       @default(false)
  maxDownlineUsers Int           @default(0)
  
  // MoMo Payout Details (cached for faster payouts)
  momoNetwork      String?       // MTN, VOD, ATL
  momoNumber       String?       // Mobile money number
  momoName         String?       // Account holder name
  momoRecipientCode String?      // Paystack recipient_code (cached)
  
  // Security
  lastLoginAt      DateTime?
  lastLoginIp      String?
  failedLoginAttempts Int        @default(0)
  lockedUntil      DateTime?
  passwordChangedAt DateTime?     // Track when password was last changed for token invalidation
  
  // Password Reset
  resetToken       String?       @unique
  resetTokenExpiry DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  parentUser   User?     @relation("UserHierarchy", fields: [parentUserId], references: [id])
  downlineUsers User[]   @relation("UserHierarchy")
  wallet       Wallet?
  orders       Order[]
  orderGroups  OrderGroup[] @relation("UserOrderGroups")
  auditLogs    AuditLog[]
  profitsEarned ProfitRecord[] @relation("ProfitBeneficiary")
  profitsGenerated ProfitRecord[] @relation("ProfitSource")
  
  // Storefront & MoMo relations
  storefronts      Storefront[]
  momoReceived     MomoTransaction[] @relation("MomoRecipient")
  momoInitiated    MomoTransaction[] @relation("MomoInitiator")
  momoClaimed      MomoTransaction[] @relation("MomoClaimer")
  pendingPayments  PendingPayment[]
  
  // Complaint relations
  complaints           Complaint[]
  assignedComplaints   Complaint[]         @relation("AssignedComplaints")
  complaintResponses   ComplaintResponse[]
  
  // Payout relations
  payouts              AgentPayout[]
  reviewedPayouts      AgentPayout[]       @relation("PayoutReviewer")
  
  // Pending profit relations
  pendingProfits       PendingProfit[]
  
  // Admin profit adjustments
  profitAdjustments    AdminProfitAdjustment[]

  @@index([tenantId])
  @@index([parentUserId])
  @@index([email])
  @@map("users")
}

// ============================================
// WALLET & LEDGER SYSTEM
// ============================================

model Wallet {
  id              String   @id @default(uuid())
  userId          String   @unique
  balance         Float    @default(0)        // Available balance
  pendingBalance  Float    @default(0)        // Pending (awaiting confirmation)
  lockedBalance   Float    @default(0)        // Locked (reserved for operations)
  
  // Daily tracking for caps
  dailyCredits    Float    @default(0)
  dailyDebits     Float    @default(0)
  dailyCreditLimit Float?
  dailyDebitLimit Float?
  dailyResetAt    DateTime @default(now())
  
  // Freeze capability
  isFrozen        Boolean  @default(false)
  frozenAt        DateTime?
  frozenReason    String?
  frozenBy        String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries   WalletLedger[]
  transactions    Transaction[]

  @@map("wallets")
}

// Immutable ledger for wallet transactions
model WalletLedger {
  id            String    @id @default(uuid())
  walletId      String
  
  entryType     TransactionType
  amount        Float
  runningBalance Float
  
  orderId       String?
  transactionId String?
  profitRecordId String?
  momoTransactionId String? @unique
  
  description   String?
  reference     String    @unique
  
  createdAt     DateTime  @default(now())
  checksum      String?
  
  wallet        Wallet    @relation(fields: [walletId], references: [id])
  momoTransaction MomoTransaction? @relation("MomoLedgerEntry", fields: [momoTransactionId], references: [id])
  
  @@index([walletId])
  @@index([reference])
  @@index([createdAt])
  @@map("wallet_ledger")
}

model Transaction {
  id          String            @id @default(uuid())
  walletId    String
  type        TransactionType
  amount      Float
  status      TransactionStatus @default(PENDING)
  reference   String            @unique
  description String?
  
  momoReference   String?       @unique
  momoPhone       String?
  paymentMethod   String?
  
  verifiedAt      DateTime?
  verifiedBy      String?
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([reference])
  @@index([momoReference])
  @@index([status])
  @@map("transactions")
}

// ============================================
// BUNDLE & PRICING MODELS
// ============================================

model Bundle {
  id          String   @id @default(uuid())
  name        String
  network     String
  dataAmount  String
  
  baseCost    Float    @default(0)
  basePrice   Float
  
  validity    String
  description String?
  isActive    Boolean  @default(true)
  outOfStock  Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders       Order[]
  orderItems   OrderItem[] @relation("BundleOrderItems")
  prices       BundlePrice[]
  tenantPrices TenantBundlePrice[]
  priceHistory BundlePriceHistory[]
  storefrontProducts StorefrontProduct[]
  storefrontOrders   StorefrontOrder[] @relation("StorefrontBundleOrders")
  customerFavorites  CustomerFavorite[]

  @@index([network])
  @@index([isActive])
  @@map("bundles")
}

model BundlePrice {
  id        String   @id @default(uuid())
  bundleId  String
  role      Role
  price     Float
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bundle    Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([bundleId, role])
  @@index([bundleId])
  @@index([role])
  @@map("bundle_prices")
}

// Tenant-specific price overrides
model TenantBundlePrice {
  id        String   @id @default(uuid())
  tenantId  String
  bundleId  String
  role      Role
  price     Float
  
  parentPriceAtCreation Float  @default(0)
  isValid   Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bundle    Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, bundleId, role])
  @@index([tenantId])
  @@index([bundleId])
  @@map("tenant_bundle_prices")
}

model BundlePriceHistory {
  id           String   @id @default(uuid())
  bundleId     String
  tenantId     String?
  role         Role
  
  oldPrice     Float
  newPrice     Float
  
  changedBy    String
  changeReason String?
  
  createdAt    DateTime @default(now())

  bundle       Bundle   @relation(fields: [bundleId], references: [id])

  @@index([bundleId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("bundle_price_history")
}

// ============================================
// ORDER MODEL (Extended with Financial Safety)
// ============================================

model Order {
  id             String      @id @default(uuid())
  userId         String
  bundleId       String
  tenantId       String?
  storefrontId   String?     // Order placed via storefront
  storefrontOrderId String?  @unique // Link to storefront customer order
  
  recipientPhone String
  quantity       Int         @default(1)
  
  unitPrice      Float       @default(0)
  totalPrice     Float
  baseCost       Float       @default(0)
  
  reference      String      @unique
  status         OrderStatus @default(PENDING)
  paymentStatus  String      @default("PENDING")
  
  profitDistributed Boolean  @default(false)
  
  // Price snapshot at order time
  priceSnapshot  Float?      // Locked price when order was placed
  
  processedAt    DateTime?
  processedBy    String?
  failureReason  String?
  
  // ============================================
  // FINANCIAL SAFETY FIELDS
  // ============================================
  
  // External API tracking
  externalReference String?   @unique // Reference from external provider (MCBIS)
  externalStatus    String?   // Status from external provider
  apiSentAt         DateTime? // When order was sent to external API
  apiConfirmedAt    DateTime? // When external API confirmed completion
  
  // Retry control
  retryCount        Int       @default(0)
  maxRetries        Int       @default(3)
  nextRetryAt       DateTime? // When to retry failed order
  
  // Locking (prevents concurrent processing)
  lockedAt          DateTime?
  lockedBy          String?   // Server instance that holds the lock
  lockExpiresAt     DateTime?
  
  // Idempotency
  idempotencyKey    String?   @unique // Links to IdempotencyKey
  
  // Wallet deduction tracking (CRITICAL)
  walletDeducted    Boolean   @default(false) // True = wallet was charged
  walletDeductedAt  DateTime? // When wallet was charged
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bundle         Bundle      @relation(fields: [bundleId], references: [id])
  storefront     Storefront? @relation("StorefrontOrders", fields: [storefrontId], references: [id])
  storefrontOrder StorefrontOrder?
  profitRecords  ProfitRecord[]
  complaints     Complaint[]

  @@index([userId])
  @@index([tenantId])
  @@index([storefrontId])
  @@index([reference])
  @@index([status])
  @@index([createdAt])
  @@index([externalReference])
  @@index([nextRetryAt])
  @@index([lockedAt])
  @@map("orders")
}

// ============================================
// ORDER GROUP MODEL (Bank-Grade Batch Orders)
// ============================================
// Represents a single checkout transaction
// Multiple items share ONE order ID (ORD-XXXXXX)

model OrderGroup {
  id              String      @id @default(uuid())
  
  // GLOBAL SEQUENTIAL ID - Never resets, auto-incremented by database
  sequenceNum     Int         @default(autoincrement())
  displayId       String?     @unique // Formatted: "ORD-000001"
  
  // Customer
  userId          String
  tenantId        String?
  
  // Order Summary
  itemCount       Int         @default(1)
  totalAmount     Float
  status          OrderStatus @default(PENDING)
  summaryStatus   String      @default("PENDING") // Derived from items
  
  // Idempotency - Prevents duplicate orders
  idempotencyKey  String      @unique
  
  // Financial Tracking
  walletDeducted    Boolean   @default(false)
  walletDeductedAt  DateTime?
  
  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  // Relations
  user            User        @relation("UserOrderGroups", fields: [userId], references: [id])
  items           OrderItem[]
  
  @@index([userId])
  @@index([tenantId])
  @@index([sequenceNum])
  @@index([displayId])
  @@index([status])
  @@index([createdAt])
  @@index([idempotencyKey])
  @@map("order_groups")
}

// ============================================
// ORDER ITEM MODEL (Individual Line Items)
// ============================================
// Each item within an OrderGroup
// Has its own status for API tracking

model OrderItem {
  id              String      @id @default(uuid())
  orderGroupId    String
  
  // Item details
  bundleId        String
  recipientPhone  String
  quantity        Int         @default(1)
  
  // Pricing (snapshot at order time)
  unitPrice       Float
  totalPrice      Float
  baseCost        Float       @default(0)
  
  // Reference (e.g., "ORD-000001-01")
  reference       String      @unique
  itemIndex       Int         @default(1) // Position in batch (1, 2, 3...)
  
  // Status
  status          OrderStatus @default(PENDING)
  processedAt     DateTime?
  failureReason   String?
  
  // External API tracking (MCBIS)
  externalReference String?   @unique
  externalStatus    String?
  apiSentAt         DateTime?
  apiConfirmedAt    DateTime?
  
  // Retry control
  retryCount        Int       @default(0)
  maxRetries        Int       @default(3)

  // ============================================================
  // TOPUPGH BATCH FIELDS
  // ============================================================
  // Set when item is routed to TopUpGH and waiting in queue
  topupghQueuedAt     DateTime?   // When item entered the TopUpGH queue
  // Set after batch is dispatched to TopUpGH
  topupghBatchId      String?     // FK to TopUpGHBatch
  // Set after delivery-status response matches this item
  topupghItemId       String?     // e.g. "123456-1" from TopUpGH delivery response
  topupghDeliveryStatus String?   // e.g. "Delivered", "Failed", "Pending"
  topupghDeliveryDate  DateTime?  // When TopUpGH confirmed delivery
  
  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  // Relations
  orderGroup      OrderGroup  @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)
  bundle          Bundle      @relation("BundleOrderItems", fields: [bundleId], references: [id])
  topupghBatch    TopUpGHBatch? @relation(fields: [topupghBatchId], references: [id])
  
  @@index([orderGroupId])
  @@index([bundleId])
  @@index([status])
  @@index([reference])
  @@index([externalReference])
  @@index([topupghBatchId])
  @@index([topupghQueuedAt])
  @@index([createdAt])
  @@map("order_items")
}

// ============================================================
// TOPUPGH BATCH MODEL
// ============================================================
// One record per dispatch to the TopUpGH /orders/create endpoint.
// Up to 300 MTN items per batch; minimum 5 before dispatching.

enum TopUpGHBatchStatus {
  SUBMITTED    // Sent to TopUpGH, awaiting delivery confirmation
  PARTIAL      // Some items delivered, some still pending
  DELIVERED    // All items confirmed delivered
  FAILED       // API call failed; items NOT sent
}

model TopUpGHBatch {
  id              String              @id @default(uuid())

  // Internal sequential ID for display (BATCH-000001)
  sequenceNum     Int                 @default(autoincrement())
  batchRef        String?             @unique   // e.g. "BATCH-000001"

  // TopUpGH side
  topupghOrderId  Int?                          // order_id returned by TopUpGH API
  status          TopUpGHBatchStatus  @default(SUBMITTED)

  // Counts (from API response)
  itemCount       Int                 @default(0)
  itemsAdded      Int                 @default(0)
  itemsSkipped    Int                 @default(0)

  // Financials (from API response)
  totalAmount     Float               @default(0)
  previousBalance Float               @default(0)
  walletDeducted  Float               @default(0)
  newBalance      Float               @default(0)

  // Raw API response for audit
  rawResponse     Json?

  // Timing
  sentAt          DateTime?           // When we dispatched to TopUpGH
  deliveryCheckedAt DateTime?         // Last time we polled delivery status

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  items           OrderItem[]

  @@index([sequenceNum])
  @@index([batchRef])
  @@index([topupghOrderId])
  @@index([status])
  @@index([sentAt])
  @@index([createdAt])
  @@map("topupgh_batches")
}

// ============================================
// PROFIT DISTRIBUTION MODEL
// ============================================

model ProfitRecord {
  id              String   @id @default(uuid())
  orderId         String
  tenantId        String?
  
  beneficiaryId   String
  sourceUserId    String
  
  amount          Float
  profitType      String
  hierarchyLevel  Int
  
  sellingPrice    Float
  costPrice       Float
  marginPercent   Float
  
  status          TransactionStatus @default(PENDING)
  creditedAt      DateTime?
  
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id])
  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
  beneficiary     User     @relation("ProfitBeneficiary", fields: [beneficiaryId], references: [id])
  sourceUser      User     @relation("ProfitSource", fields: [sourceUserId], references: [id])

  @@index([orderId])
  @@index([beneficiaryId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("profit_records")
}

// ============================================
// AUDIT & COMPLIANCE
// ============================================

model AuditLog {
  id          String      @id @default(uuid())
  
  userId      String?
  tenantId    String?
  ipAddress   String?
  userAgent   String?
  
  action      AuditAction
  entityType  String
  entityId    String?
  
  oldValues   Json?
  newValues   Json?
  metadata    Json?
  
  createdAt   DateTime    @default(now())

  user        User?       @relation(fields: [userId], references: [id])
  tenant      Tenant?     @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Admin Alerts - Important notifications for administrators
model AdminAlert {
  id          String        @id @default(uuid())
  type        AlertType
  severity    AlertSeverity @default(MEDIUM)
  title       String
  message     String
  
  // Related entity
  entityType  String?       // "AgentPayout", "Order", etc.
  entityId    String?
  
  // Metadata for context
  metadata    Json?
  
  // Status
  isRead      Boolean       @default(false)
  readBy      String?
  readAt      DateTime?
  isDismissed Boolean       @default(false)
  dismissedBy String?
  dismissedAt DateTime?
  
  // Auto-resolve
  isResolved  Boolean       @default(false)
  resolvedAt  DateTime?
  
  createdAt   DateTime      @default(now())
  
  @@index([type])
  @@index([severity])
  @@index([isRead])
  @@index([isDismissed])
  @@index([createdAt])
  @@map("admin_alerts")
}

enum AlertType {
  PAYOUT_FAILED
  PAYOUT_STUCK
  LOW_PAYSTACK_BALANCE
  WEBHOOK_FAILURE
  SYSTEM_ERROR
  SECURITY_ALERT
  HIGH_WITHDRAWAL_VOLUME
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================
// SYSTEM SETTINGS & CONFIGURATION
// ============================================

model SystemSettings {
  id            String   @id @default(uuid())
  key           String   @unique
  value         Json
  description   String?
  isPublic      Boolean  @default(false)
  
  updatedAt     DateTime @updatedAt
  updatedBy     String?

  @@map("system_settings")
}

model FeatureFlag {
  id          String   @id @default(uuid())
  name        String   @unique
  isEnabled   Boolean  @default(false)
  tenantIds   String[]
  roleAccess  Role[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

// ============================================
// USER-GENERATED STOREFRONTS
// ============================================

enum StorefrontStatus {
  ACTIVE
  SUSPENDED
  DISABLED
  PENDING_APPROVAL
}

model Storefront {
  id              String           @id @default(uuid())
  
  // Ownership
  ownerId         String
  tenantId        String?
  
  // Identification
  slug            String           @unique  // URL: kemplus.com/store/{slug}
  name            String
  description     String?
  
  // Branding
  logoUrl         String?
  bannerUrl       String?
  primaryColor    String?          @default("#024959")
  accentColor     String?          @default("#F2C12E")
  
  // Contact
  contactPhone    String?
  contactEmail    String?
  contactWhatsapp String?
  
  // Payment Settings
  momoNumber      String?          // MoMo number for customer payments
  momoName        String?          // Name on MoMo account
  paystackEnabled Boolean          @default(true)   // Enable Paystack for this store
  
  // Settings
  isPublic        Boolean          @default(true)
  showOwnerInfo   Boolean          @default(false)
  allowDirectContact Boolean       @default(true)
  
  // Status
  status          StorefrontStatus @default(ACTIVE)
  suspendedAt     DateTime?
  suspendedReason String?
  suspendedBy     String?
  
  // Analytics
  totalOrders     Int              @default(0)
  totalRevenue    Float            @default(0)
  viewCount       Int              @default(0)
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  // Relations
  owner           User             @relation(fields: [ownerId], references: [id])
  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  orders          Order[]          @relation("StorefrontOrders")
  products        StorefrontProduct[]
  customerOrders  StorefrontOrder[]
  customerFavorites CustomerFavorite[]
  pendingProfits  PendingProfit[]
  
  @@index([ownerId])
  @@index([tenantId])
  @@index([slug])
  @@index([status])
  @@map("storefronts")
}

// Products displayed on storefront (links to bundles with custom pricing)
model StorefrontProduct {
  id            String     @id @default(uuid())
  storefrontId  String
  bundleId      String
  
  // Custom display
  displayName   String?
  displayOrder  Int        @default(0)
  isVisible     Boolean    @default(true)
  
  // Price snapshot (owner's cost price at time of adding)
  priceSnapshot Float
  
  // Custom selling price (must be >= priceSnapshot)
  sellingPrice  Float?     // If null, use priceSnapshot (no markup)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  storefront    Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  bundle        Bundle     @relation(fields: [bundleId], references: [id])
  
  @@unique([storefrontId, bundleId])
  @@index([storefrontId])
  @@map("storefront_products")
}

// Customer orders placed through storefronts
model StorefrontOrder {
  id                  String        @id @default(uuid())
  storefrontId        String
  storefrontProductId String?
  
  // Customer info (no account required)
  customerPhone       String
  customerName        String?
  
  // Bundle ordered
  bundleId            String
  
  // Pricing (snapshots at order time)
  amount              Float         // Customer paid (agent's selling price)
  ownerCost           Float         // Store owner's cost price (AGENT role price = minimum)
  ownerProfit         Float         // amount - ownerCost (agent's profit)
  
  // Financial tracking (for Paystack orders)
  supplierCost        Float?        // Platform's cost (Bundle.baseCost)
  platformProfit      Float?        // ownerCost - supplierCost
  profitCredited      Boolean       @default(false)  // Has agent profit been credited?
  profitCreditedAt    DateTime?     // When profit was credited to agent wallet
  
  // Payment
  paymentStatus       String        @default("PENDING")  // PENDING, PAID, FAILED
  paymentMethod       String?       // MOMO, PAYSTACK
  paymentReference    String?       // Customer's MoMo transaction reference or Paystack reference
  paymentPhone        String?       // Phone number customer paid from
  paystackReference   String?       // Paystack transaction reference (if used)
  
  // Status
  status              String        @default("PENDING")  // PENDING, PROCESSING, COMPLETED, FAILED, REFUNDED
  
  // Linked main order (for fulfillment)
  orderId             String?       @unique
  
  // Timestamps
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  
  // Relations
  storefront          Storefront    @relation(fields: [storefrontId], references: [id])
  bundle              Bundle        @relation("StorefrontBundleOrders", fields: [bundleId], references: [id])
  order               Order?        @relation(fields: [orderId], references: [id])
  
  @@index([storefrontId])
  @@index([customerPhone])
  @@index([status])
  @@map("storefront_orders")
}

// ============================================
// MOMO SEND & CLAIM SYSTEM
// ============================================

enum MomoTransactionStatus {
  INITIATED      // Admin initiated send
  PENDING_CLAIM  // Waiting for claim
  CLAIMED        // Successfully claimed
  EXPIRED        // Claim window expired
  CANCELLED      // Admin cancelled
  FAILED         // Claim verification failed
}

model MomoTransaction {
  id              String                @id @default(uuid())
  
  // Transaction Details
  reference       String                @unique  // Unique system reference
  momoReference   String?               @unique  // MoMo network reference (after send)
  
  // Parties
  targetUserId    String                // User to receive funds
  initiatedBy     String                // Admin who initiated
  claimedBy       String?               // Admin who processed claim
  
  // Amount
  amount          Float
  fee             Float                 @default(0)
  netAmount       Float                 // amount - fee
  
  // Phone
  targetPhone     String
  
  // Status
  status          MomoTransactionStatus @default(INITIATED)
  
  // Timestamps
  initiatedAt     DateTime              @default(now())
  sentAt          DateTime?             // When MoMo send was executed
  claimedAt       DateTime?
  expiresAt       DateTime              // Claim window expiration
  
  // Verification
  claimCode       String?               // Optional claim verification code
  verificationNotes String?
  
  // Audit
  metadata        Json?
  ipAddress       String?
  
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  
  // Relations
  targetUser      User                  @relation("MomoRecipient", fields: [targetUserId], references: [id])
  initiator       User                  @relation("MomoInitiator", fields: [initiatedBy], references: [id])
  claimer         User?                 @relation("MomoClaimer", fields: [claimedBy], references: [id])
  walletLedgerEntry WalletLedger?       @relation("MomoLedgerEntry")
  
  @@index([targetUserId])
  @@index([status])
  @@index([reference])
  @@index([momoReference])
  @@index([expiresAt])
  @@map("momo_transactions")
}

// ============================================
// STORE CUSTOMER ACCOUNTS
// ============================================

// Customers who create accounts on storefronts
model StoreCustomer {
  id              String   @id @default(uuid())
  
  // Authentication
  phone           String   // Primary identifier (phone number)
  pin             String   // 4-6 digit PIN (hashed)
  
  // Profile
  name            String?
  email           String?
  
  // Settings
  isActive        Boolean  @default(true)
  
  // Timestamps
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  favorites       CustomerFavorite[]
  
  @@unique([phone])
  @@index([phone])
  @@map("store_customers")
}

// Customer favorite bundles
model CustomerFavorite {
  id              String   @id @default(uuid())
  
  customerId      String
  bundleId        String
  storefrontId    String
  
  createdAt       DateTime @default(now())
  
  // Relations
  customer        StoreCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bundle          Bundle        @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  storefront      Storefront    @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  
  @@unique([customerId, bundleId, storefrontId])
  @@index([customerId])
  @@index([bundleId])
  @@map("customer_favorites")
}

// ============================================
// FINANCIAL SAFETY MODELS
// ============================================

// Idempotency keys prevent duplicate operations
model IdempotencyKey {
  id              String    @id @default(uuid())
  key             String    @unique
  operationType   String
  userId          String
  orderId         String?
  requestHash     String
  responseData    Json?
  status          String    @default("PENDING") // PENDING, COMPLETED, FAILED
  lockedAt        DateTime?
  lockedBy        String?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// API audit log for all external API interactions
model ApiAuditLog {
  id                  String    @id @default(uuid())
  orderId             String
  idempotencyKey      String?
  operation           String
  externalReference   String?
  requestUrl          String
  requestMethod       String
  requestHeadersHash  String?
  requestPayloadHash  String
  requestPayload      Json?
  responseStatus      Int?
  responsePayloadHash String?
  responsePayload     Json?
  responseTimeMs      Int?
  retryNumber         Int       @default(0)
  errorMessage        String?
  errorCode           String?
  serverInstance      String?
  createdAt           DateTime  @default(now())

  @@index([orderId])
  @@index([externalReference])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@index([operation])
  @@map("api_audit_logs")
}

// Order state transition history
model OrderStateTransition {
  id            String    @id @default(uuid())
  orderId       String
  fromState     String
  toState       String
  triggeredBy   String
  triggerSource String
  metadata      Json?
  createdAt     DateTime  @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@map("order_state_transitions")
}

// ============================================
// PAYMENT GATEWAY MODELS
// ============================================

// Pending payments from Paystack/other gateways
model PendingPayment {
  id            String    @id @default(uuid())
  reference     String    @unique  // Payment gateway reference
  userId        String
  amount        Float                // Amount in GHS
  provider      String    @default("PAYSTACK") // PAYSTACK, MOMO, etc.
  status        String    @default("PENDING")  // PENDING, COMPLETED, FAILED, EXPIRED
  channel       String?              // mobile_money, card, bank_transfer
  metadata      Json?                // Additional data from gateway
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  
  user          User      @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([status])
  @@index([reference])
  @@index([createdAt])
  @@map("pending_payments")
}

// ============================================
// COMPLAINT/SUPPORT TICKET SYSTEM
// ============================================

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  ESCALATED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintType {
  DATA_NOT_RECEIVED
  WALLET_CREDIT_ISSUE
  OTHER
}

model Complaint {
  id              String            @id @default(uuid())
  ticketNumber    String            @unique // TICKET-000001
  userId          String
  orderId         String?           // Related order if applicable
  orderGroupId    String?           // Related order group
  
  // Complaint Details
  type            ComplaintType
  subject         String
  description     String            @db.Text
  affectedPhone   String?           // Phone number affected
  dataSize        String?           // Data bundle size (e.g. 2GB, 5GB)
  txDate          DateTime?         // Transaction date
  txRef           String?           // Transaction reference
  amount          Float?            // Amount involved
  
  // Status & Priority
  status          ComplaintStatus   @default(OPEN)
  priority        ComplaintPriority @default(MEDIUM)
  
  // Admin Response
  assignedTo      String?           // Admin user ID
  adminResponse   String?           @db.Text
  internalNotes   String?           @db.Text
  resolution      String?           @db.Text
  
  // Actions Taken
  refundAmount    Float?            // If refund was issued
  refundedAt      DateTime?
  dataResent      Boolean           @default(false)
  dataResentAt    DateTime?
  
  // Timestamps
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  resolvedAt      DateTime?
  resolvedBy      String?
  closedAt        DateTime?
  closedBy        String?
  escalatedAt     DateTime?
  escalatedBy     String?
  
  // Relations
  user            User              @relation(fields: [userId], references: [id])
  order           Order?            @relation(fields: [orderId], references: [id])
  assignedAdmin   User?             @relation("AssignedComplaints", fields: [assignedTo], references: [id])
  responses       ComplaintResponse[]
  
  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([createdAt])
  @@index([ticketNumber])
  @@map("complaints")
}

model ComplaintResponse {
  id            String    @id @default(uuid())
  complaintId   String
  userId        String    // Who responded (agent or admin)
  message       String    @db.Text
  isAdmin       Boolean   @default(false)
  isInternal    Boolean   @default(false) // Internal admin notes
  createdAt     DateTime  @default(now())
  
  complaint     Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id])
  
  @@index([complaintId])
  @@index([userId])
  @@index([createdAt])
  @@map("complaint_responses")
}

// ============================================
// PAYOUT MODEL - Agent Withdrawals
// ============================================

model AgentPayout {
  id                  String        @id @default(uuid())
  userId              String
  batchId             String?       // Link to PayoutBatch when processed
  
  // Payout details
  amount              Float         // Requested amount
  fee                 Float         @default(0) // Processing fee (Paystack charges)
  netAmount           Float         // Amount after fee (user receives)
  
  // Bank/Mobile Money details
  accountName         String
  accountNumber       String
  bankCode            String?       // For bank transfers
  bankName            String?
  accountType         String        @default("mobile_money") // "bank" or "mobile_money"
  
  // Paystack integration
  recipientCode       String?       // Paystack recipient code
  transferCode        String?       // Paystack transfer code
  paystackReference   String?       // Paystack's internal reference
  reference           String        @unique
  
  // Status tracking
  status              PayoutStatus  @default(PENDING)
  failureReason       String?
  reason              String?       // User's withdrawal reason/note
  
  // Admin processing
  reviewedBy          String?
  reviewedAt          DateTime?
  reviewNotes         String?
  
  // Webhook tracking
  webhookReceived     Boolean       @default(false)
  webhookData         String?       // JSON of webhook payload for audit
  
  // Manual payment tracking (when admin pays externally)
  manualPayment       Boolean       @default(false)
  manualPaymentMethod String?       // "cash", "bank_transfer", "manual_momo"
  manualReference     String?       // External payment reference
  manualNote          String?       // Admin note about the manual payment
  
  // Timestamps
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  processedAt         DateTime?
  
  // Relations
  user                User          @relation(fields: [userId], references: [id])
  reviewer            User?         @relation("PayoutReviewer", fields: [reviewedBy], references: [id])
  batch               PayoutBatch?  @relation(fields: [batchId], references: [id])
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([reference])
  @@index([batchId])
  @@index([transferCode])
  @@map("agent_payouts")
}

// ============================================
// PENDING PROFIT MODEL - Daily Batch Payouts
// ============================================

model PendingProfit {
  id              String              @id @default(uuid())
  userId          String              // Agent who earns the profit
  storefrontId    String?             // Which store generated the profit
  orderId         String?             // Order that generated the profit (StorefrontOrder)
  orderReference  String?             // Order reference for display
  
  // Profit details
  amount          Float               // Profit amount
  description     String?             // E.g., "Store sale - MTN 5GB"
  
  // Status
  status          PendingProfitStatus @default(PENDING)
  
  // Batch processing
  batchId         String?             // Links to PayoutBatch when paid
  
  // Timestamps
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  paidAt          DateTime?           // When credited to wallet
  cancelledAt     DateTime?           // When cancelled (e.g., refund)
  cancelReason    String?             // Why it was cancelled
  
  // Relations
  user            User                @relation(fields: [userId], references: [id])
  storefront      Storefront?         @relation(fields: [storefrontId], references: [id])
  batch           PayoutBatch?        @relation(fields: [batchId], references: [id])
  
  @@index([userId])
  @@index([storefrontId])
  @@index([status])
  @@index([createdAt])
  @@index([batchId])
  @@map("pending_profits")
}

model PayoutBatch {
  id              String          @id @default(uuid())
  
  // Batch details
  totalAmount     Float           @default(0) // Sum of all payouts in batch
  payoutCount     Int             @default(0) // Number of withdrawal requests processed
  successCount    Int             @default(0)
  failedCount     Int             @default(0)
  
  // Paystack bulk transfer
  bulkTransferCode String?        // Paystack bulk transfer code
  bulkTransferStatus String?      // queued, pending, success, failed
  
  // Processing
  processedAt     DateTime        @default(now())
  processedBy     String?         // Admin user ID
  processorName   String?         // Admin name for display
  
  notes           String?
  
  // Relations
  profits         PendingProfit[]
  payouts         AgentPayout[]   // All payouts in this batch
  
  @@index([processedAt])
  @@index([bulkTransferCode])
  @@map("payout_batches")
}

// ============================================
// ADMIN PROFIT ADJUSTMENT
// ============================================

model AdminProfitAdjustment {
  id         String   @id @default(uuid())
  userId     String
  amount     Float
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("admin_profit_adjustments")
}
